# Skopiuj do .env i uzupełnij
ANTHROPIC_API_KEY=
KDP_MODEL=claude-sonnet-5-5
# Opóźnienie między stronami Amazona w sekundach (bezpiecznie 4-8)
KDP_DELAY=5
# Proxy rezydencjalne (zalecane – IP z VPS-ów Amazon często blokuje)
# KDP_PROXY=http://user:pass@host:port
# ALBO zewnętrzne API do scrapowania ({url} zostanie podstawiony)
# KDP_FETCH_TEMPLATE=https://api.scraperapi.com?api_key=KLUCZ&url={url}
